{
  "name": "happyroom",
  "private": true,
  "description": "HAPPYROOM \u2014 Celebrate Together. Anywhere.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@happyroom/web --filter=@happyroom/game-server --filter=@happyroom/shared --filter=@happyroom/game-core",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @happyroom/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-migrate.mjs --seed && pnpm world:sync",
    "db:reset": "node scripts/db-migrate.mjs --reset --seed && pnpm world:sync",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:integration": "pnpm --filter @happyroom/integration-tests test:integration && pnpm --filter @happyroom/game-server test:integration",
    "world:sync": "pnpm --filter @happyroom/world build && node scripts/world-sync.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
