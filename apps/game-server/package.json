{
  "name": "@happyroom/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude \"src/**/*.test.ts\"",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@colyseus/core": "0.18.19",
    "@colyseus/schema": "5.0.41",
    "@colyseus/ws-transport": "0.18.4",
    "@happyroom/game-core": "workspace:*",
    "@happyroom/shared": "workspace:*",
    "@happyroom/world": "workspace:*",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.5",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
