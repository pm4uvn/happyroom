# Copy to .env (root) and apps/web/.env.local. Never commit real secrets.
# Variables marked [M1] are used today; others are reserved for the milestone noted.

# --- Database [M1] -----------------------------------------------------------
# Local docker compose default. For Supabase use the pooled connection string (server-side only).
DATABASE_URL=postgres://happyroom:happyroom@localhost:54329/happyroom

# --- Web app [M1] ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Feature flags: features stay disabled until their milestone is implemented and verified.
NEXT_PUBLIC_FEATURE_CREATE_ROOM=true
NEXT_PUBLIC_FEATURE_JOIN_ROOM=true

# --- Analytics [M1 ingestion, M8 PostHog] -----------------------------------
# First-party ingestion (/api/events -> analytics_events) works with DATABASE_URL alone.
# PostHog forwarding is only enabled when a key is present.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Supabase Auth (optional registered login) [M2+] -------------------------
NEXT_PUBLIC_SUPABASE_URL=
# New-style publishable key (preferred) and legacy anon JWT. Both are PUBLIC, browser-safe keys:
# RLS (supabase/migrations) is what protects data, not secrecy of these keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# HAPPYROOM World: Google sign-in via Supabase Auth. Set to true ONLY after enabling the Google
# provider in the Supabase dashboard with <app>/auth/callback as a redirect URL. Guest and
# username/password sign-in work without it.
AUTH_GOOGLE_ENABLED=false
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Join grants (shared by web + game server) [M2] -----------------------
# 32+ random bytes, base64url. start.bat generates one automatically if empty.
# Generate manually: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JOIN_GRANT_SIGNING_KEY=

# --- Redis (rate limits, multi-process coordination) [M2] --------------------
REDIS_URL=redis://localhost:63790

# --- Game server [M3/M4] ----------------------------------------------------
GAME_SERVER_PORT=2567
# WebSocket URL browsers use to reach the game server (read at runtime by the web API).
GAME_SERVER_PUBLIC_URL=ws://localhost:2567
# Comma-separated allowed WebSocket origins (empty = any; set in production).
GAME_ALLOWED_ORIGINS=

# --- Object storage (Cloudflare R2 / S3-compatible) [M5] ---------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=happyroom-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Gemini (optional AI wish suggestions) [post-MVP] ------------------------
GEMINI_API_KEY=
